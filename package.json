{
  "name": "test-case-manager",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "extension",
    "viewer"
  ],
  "scripts": {
    "dev": "npm run dev -w extension",
    "dev:viewer": "npm run dev -w viewer",
    "build": "npm run build -w extension",
    "build:viewer": "npm run build -w viewer",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w extension && npm run typecheck -w viewer"
  }
}
